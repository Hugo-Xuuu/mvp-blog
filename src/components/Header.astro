---
import ThemeToggle from './ThemeToggle.astro';
---

<header class="fixed top-0 inset-x-0 z-50 px-4 sm:px-6 pt-4">
  <nav class="mx-auto max-w-5xl flex items-center justify-between rounded-2xl border border-[var(--header-border)] bg-[var(--header-bg)] backdrop-blur-xl px-5 py-3 shadow-lg shadow-black/5">
    <a href="/" class="flex items-center gap-3 font-semibold tracking-tight">
      <img src="/avatar.jpg" alt="头像" class="w-8 h-8 rounded-lg object-cover" />
      <span class="text-[var(--text-primary)]">白日梦的博客</span>
    </a>

    <!-- 桌面端导航 -->
    <div class="hidden sm:flex items-center gap-3">
      <button id="search-toggle" aria-label="搜索" title="搜索 (⌘K)" class="grid h-9 w-9 place-items-center rounded-lg border border-[var(--border-color)] bg-[var(--bg-card)] transition-transform hover:scale-105 active:scale-95">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"/>
        </svg>
      </button>
      <a href="/blog" class="text-sm font-medium text-[var(--nav-link)] hover:text-indigo-500 dark:hover:text-indigo-400 transition-colors">文章</a>
      <a href="/archive" class="text-sm font-medium text-[var(--nav-link)] hover:text-indigo-500 dark:hover:text-indigo-400 transition-colors">归档</a>
      <a href="/tags" class="text-sm font-medium text-[var(--nav-link)] hover:text-indigo-500 dark:hover:text-indigo-400 transition-colors">标签</a>
      <a href="/about" class="text-sm font-medium text-[var(--nav-link)] hover:text-indigo-500 dark:hover:text-indigo-400 transition-colors">关于</a>
      <ThemeToggle />
    </div>

    <!-- 移动端：搜索 + 菜单按钮 -->
    <div class="flex sm:hidden items-center gap-2">
      <button id="search-toggle-mobile" aria-label="搜索" class="grid h-9 w-9 place-items-center rounded-lg border border-[var(--border-color)] bg-[var(--bg-card)] transition-transform hover:scale-105 active:scale-95">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"/>
        </svg>
      </button>
      <button id="mobile-menu-toggle" aria-label="菜单" class="grid h-9 w-9 place-items-center rounded-lg border border-[var(--border-color)] bg-[var(--bg-card)] transition-transform hover:scale-105 active:scale-95">
        <svg id="menu-icon" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </nav>
</header>

<!-- 移动端全屏菜单 -->
<div id="mobile-nav" class="mobile-nav-overlay" onclick="if(event.target===this)closeMobileNav()">
  <div class="mobile-nav-panel relative">
    <!-- 关闭按钮 -->
    <button id="mobile-close-btn" aria-label="关闭菜单" class="absolute top-4 right-4 grid h-8 w-8 place-items-center rounded-full bg-black/5 dark:bg-white/10 hover:bg-black/10 dark:hover:bg-white/20 transition-colors" onclick="closeMobileNav()">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <!-- 头像与博客名 -->
    <div class="flex flex-col items-center mb-8 mt-2">
      <img src="/avatar.jpg" alt="头像" class="w-16 h-16 rounded-2xl object-cover shadow-lg shadow-black/10 mb-3" />
      <span class="text-lg font-semibold text-[var(--text-primary)]">白日梦的博客</span>
    </div>

    <!-- 导航链接列表 -->
    <div class="flex flex-col gap-1 w-full">
      <a href="/" class="mobile-nav-link-item" onclick="closeMobileNav()">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        <span>首页</span>
      </a>
      <a href="/blog" class="mobile-nav-link-item" onclick="closeMobileNav()">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
        </svg>
        <span>文章</span>
      </a>
      <a href="/archive" class="mobile-nav-link-item" onclick="closeMobileNav()">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>
        </svg>
        <span>归档</span>
      </a>
      <a href="/tags" class="mobile-nav-link-item" onclick="closeMobileNav()">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
        </svg>
        <span>标签</span>
      </a>
      <a href="/about" class="mobile-nav-link-item" onclick="closeMobileNav()">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
        <span>关于</span>
      </a>
    </div>

    <!-- 底部主题切换（iOS 风格） -->
    <div class="mt-8 flex items-center gap-3 px-4 py-3 rounded-xl bg-black/5 dark:bg-white/10 w-full">
      <svg class="w-4 h-4 text-amber-500 dark:text-amber-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2m0 14v2m9-9h-2M5 12H3m14.45 6.95-1.41-1.41M6.46 6.46 5.05 5.05m12.49 0-1.41 1.41M6.46 17.54l-1.41 1.41M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"/>
      </svg>
      <span class="text-sm text-[var(--text-secondary)]">深色模式</span>
      <div class="flex-1"></div>
      <button id="theme-toggle-mobile" aria-label="切换主题" class="relative inline-flex h-7 w-12 shrink-0 items-center rounded-full transition-colors duration-300 ease-in-out focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 bg-gray-300 dark:bg-indigo-500">
        <span class="inline-flex h-5 w-5 translate-x-1 dark:translate-x-6 transform items-center justify-center rounded-full bg-white shadow-sm ring-0 transition-all duration-300 ease-in-out">
          <svg class="h-3 w-3 text-amber-500 block dark:hidden" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 3v2m0 14v2m9-9h-2M5 12H3m14.45 6.95-1.41-1.41M6.46 6.46 5.05 5.05m12.49 0-1.41 1.41M6.46 17.54l-1.41 1.41M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"/>
          </svg>
          <svg class="h-3 w-3 text-indigo-500 hidden dark:block" fill="currentColor" viewBox="0 0 24 24">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/>
          </svg>
        </span>
      </button>
    </div>
  </div>
</div>

<script>
  // 搜索按钮
  const openSearch = () => {
    if (typeof document !== 'undefined') {
      document.dispatchEvent(new CustomEvent('open-search'));
    }
  };
  document.getElementById('search-toggle')?.addEventListener('click', openSearch);
  document.getElementById('search-toggle-mobile')?.addEventListener('click', openSearch);

  // 移动端菜单
  const mobileMenu = document.getElementById('mobile-nav');
  const menuToggle = document.getElementById('mobile-menu-toggle');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  if (mobileMenu && menuToggle) {
    window.openMobileNav = () => {
      mobileMenu.classList.add('open');
      document.body.style.overflow = 'hidden';
      menuIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      const panel = mobileMenu.querySelector('.mobile-nav-panel');
      if (panel) {
        panel.classList.remove('panel-exit');
        panel.classList.add('panel-enter');
      }
    };
    window.closeMobileNav = () => {
      const panel = mobileMenu.querySelector('.mobile-nav-panel');
      if (panel) {
        panel.classList.remove('panel-enter');
        panel.classList.add('panel-exit');
      }
      setTimeout(() => {
        mobileMenu.classList.remove('open');
        document.body.style.overflow = '';
      }, 250);
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    };
    menuToggle.addEventListener('click', () => {
      if (mobileMenu.classList.contains('open')) {
        window.closeMobileNav();
      } else {
        window.openMobileNav();
      }
    });
  }

  // 移动端主题切换 — 带过渡动画
  const root = document.documentElement;
  const mobileToggle = document.getElementById('theme-toggle-mobile');
  if (mobileToggle) {
    const dot = mobileToggle.querySelector('span');
    const updateToggle = () => {
      const isDark = root.classList.contains('dark');
      if (dot) {
        dot.classList.toggle('translate-x-1', !isDark);
        dot.classList.toggle('translate-x-6', isDark);
      }
      mobileToggle.classList.toggle('bg-gray-300', !isDark);
      mobileToggle.classList.toggle('bg-indigo-500', isDark);
    };
    updateToggle();
    mobileToggle.addEventListener('click', () => {
      root.classList.toggle('dark');
      localStorage.setItem('theme', root.classList.contains('dark') ? 'dark' : 'light');
      updateToggle();
      // 同时触发桌面端 toggle 的图标更新（通过 class 变化自动生效）
    });
    const observer = new MutationObserver(updateToggle);
    observer.observe(root, { attributes: true, attributeFilter: ['class'] });
  }
</script>