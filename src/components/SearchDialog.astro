<!-- 搜索弹窗 — 直接渲染 -->
<div id="search-overlay" class="search-overlay">
  <div id="search-dialog" class="search-dialog">
    <div class="search-input-wrapper">
      <svg class="w-5 h-5 text-[var(--text-tertiary)] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"/>
      </svg>
      <input id="search-input" class="search-input" type="text" placeholder="搜索文章标题或内容..." />
      <kbd class="hidden sm:inline-flex items-center gap-1 px-2 py-1 text-xs rounded border border-[var(--border-color)] text-[var(--text-tertiary)]">
        <span>⌘</span>K
      </kbd>
    </div>
    <div id="search-results" class="search-results">
      <div class="search-empty"><p>输入关键词开始搜索</p></div>
    </div>
  </div>
</div>

<script>
import Fuse from 'fuse.js';

(function() {
  const overlay = document.getElementById('search-overlay');
  const dialog = document.getElementById('search-dialog');
  const input = document.getElementById('search-input');
  const resultsContainer = document.getElementById('search-results');

  if (!overlay || !dialog || !input || !resultsContainer) return;

  let allPosts = [];
  let fuse = null;
  let isOpen = false;
  let searchTerm = '';

  async function initSearch() {
    if (fuse) return;
    try {
      const res = await fetch('/search-index.json');
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      allPosts = await res.json();

      fuse = new Fuse(allPosts, {
        keys: [
          { name: 'title', weight: 3 },
          { name: 'description', weight: 1 },
          { name: 'content', weight: 0.5 },
        ],
        threshold: 0.3,
        minMatchCharLength: 2,
        ignoreLocation: true,
      });

      if (searchTerm) doSearch(searchTerm);
    } catch (err) {
      console.error('Search init failed:', err);
      resultsContainer.innerHTML =
        '<div class="search-empty"><p>搜索功能加载失败，请刷新重试</p></div>';
    }
  }

  function doSearch(term) {
    searchTerm = term;
    if (!allPosts.length || !term.trim()) {
      resultsContainer.innerHTML =
        '<div class="search-empty"><p>' +
        (term.trim() ? '索引加载中…' : '输入关键词开始搜索') +
        '</p></div>';
      return;
    }

    const raw = term.trim();

    // 策略1: 精确子串匹配（标题优先）
    const lowerTerm = raw.toLowerCase();
    const exactMatches = allPosts.filter((p) =>
      p.title.toLowerCase().includes(lowerTerm)
    );
    // 如果标题精确匹配不够，再从内容找
    if (exactMatches.length < 3) {
      allPosts.forEach((p) => {
        if (!exactMatches.includes(p) && (
          (p.description || '').toLowerCase().includes(lowerTerm) ||
          (p.content || '').toLowerCase().includes(lowerTerm)
        )) {
          exactMatches.push(p);
        }
      });
    }

    let matched = exactMatches;

    // 策略2: 如果精确匹配太少，用 Fuse 模糊搜索补充
    if (matched.length < 3 && fuse) {
      const fuseResults = fuse.search(raw);
      const fuseItems = fuseResults.map((r) => r.item);
      // 合并去重
      const existingSlugs = new Set(matched.map((p) => p.slug));
      fuseItems.forEach((p) => {
        if (!existingSlugs.has(p.slug)) {
          matched.push(p);
          existingSlugs.add(p.slug);
        }
      });
    }

    if (matched.length === 0) {
      resultsContainer.innerHTML =
        '<div class="search-empty"><p>未找到与 "<strong>' +
        escapeHtml(raw) +
        '</strong>" 相关的内容</p></div>';
      return;
    }

    resultsContainer.innerHTML = matched
      .slice(0, 20)
      .map((item) => {
        const contentText = item.content || item.description || '';

        // 截取包含搜索词的上下文片段（不做高亮标记）
        const excerpt = extractExcerpt(contentText, raw);

        const tagsHtml = (item.tags || [])
          .map((t) => `<span class="text-xs text-[var(--text-tertiary)]">#${escapeHtml(t)}</span>`)
          .join(' ');

        return `<a href="/blog/${item.slug}" class="search-result-item">
          <div class="search-result-title">${escapeHtml(item.title)}</div>
          ${excerpt ? `<div class="search-result-excerpt">${excerpt}</div>` : ''}
          <div class="flex flex-wrap gap-1 mt-1">${tagsHtml}</div>
        </a>`;
      })
      .join('');
  }

  /** 从内容中截取包含搜索词的片段（纯文本，无高亮标记） */
  function extractExcerpt(content, term) {
    if (!content || !term) return '';
    const lowerContent = content.toLowerCase();
    const lowerTerm = term.toLowerCase();
    const idx = lowerContent.indexOf(lowerTerm);
    if (idx === -1) return '';

    const contextLen = 50;
    const start = Math.max(0, idx - contextLen);
    const end = Math.min(content.length, idx + term.length + contextLen);
    let excerpt = content.slice(start, end);

    if (start > 0) excerpt = '…' + excerpt;
    if (end < content.length) excerpt = excerpt + '…';

    return escapeHtml(excerpt);
  }

  function escapeHtml(str) {
    return String(str)
      .replace(/&/g, '&')
      .replace(/</g, '<')
      .replace(/>/g, '>')
      .replace(/"/g, '"');
  }

  function openSearch() {
    if (isOpen) return;
    isOpen = true;
    overlay.classList.add('open');
    dialog.classList.add('open');
    document.body.style.overflow = 'hidden';
    input.value = '';
    resultsContainer.innerHTML = '<div class="search-empty"><p>输入关键词开始搜索</p></div>';
    searchTerm = '';
    setTimeout(() => input.focus(), 150);
    initSearch();
  }

  function closeSearch() {
    if (!isOpen) return;
    isOpen = false;
    overlay.classList.remove('open');
    dialog.classList.remove('open');
    document.body.style.overflow = '';
    input.blur();
  }

  // 事件绑定
  input.addEventListener('input', (e) => doSearch(e.target.value));

  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) closeSearch();
  });

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      isOpen ? closeSearch() : openSearch();
    }
    if (e.key === 'Escape' && isOpen) closeSearch();
  });

  input.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSearch();
    if (e.key === 'Enter') {
      const firstLink = resultsContainer.querySelector('.search-result-item');
      if (firstLink) window.location.href = firstLink.getAttribute('href');
    }
  });

  window.__openSearch = openSearch;
  document.addEventListener('open-search', () => openSearch());
})();
</script>