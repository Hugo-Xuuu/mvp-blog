---
export interface Props {
  tag: string;
  active?: boolean;
  href?: string;
}

const { tag, active = false, href } = Astro.props;
---

{
  href ? (
    <a
      href={href}
      class="rounded-lg bg-black/5 dark:bg-white/10 px-3 py-1.5 text-xs font-mono transition-colors hover:bg-indigo-500 hover:text-white"
      class:list={{ 'bg-indigo-500 text-white': active }}
    >
      #{tag}
    </a>
  ) : (
    <span
      class="rounded-lg bg-black/5 dark:bg-white/10 px-3 py-1.5 text-xs font-mono transition-colors hover:bg-indigo-500 hover:text-white"
      class:list={{ 'bg-indigo-500 text-white': active }}
    >
      #{tag}
    </span>
  )
}