---
export interface Props {
  tag: string;
  active?: boolean;
  href?: string;
}

const { tag, active = false, href } = Astro.props;
---

{
  href ? (
    <a
      href={href}
      class="rounded-lg px-3 py-1.5 text-xs font-mono no-underline transition-all duration-200"
      class:list={{
        'bg-black/5 dark:bg-white/10 text-[var(--text-secondary)] hover:bg-indigo-500 hover:text-white dark:hover:bg-indigo-500 dark:hover:text-white': !active,
        'bg-indigo-500 dark:bg-indigo-500 text-white ring-2 ring-indigo-300 dark:ring-indigo-400 font-semibold shadow-sm shadow-indigo-500/20': active,
      }}
    >
      #{tag}
    </a>
  ) : (
    <span
      class="rounded-lg px-3 py-1.5 text-xs font-mono no-underline transition-all duration-200"
      class:list={{
        'bg-black/5 dark:bg-white/10 text-[var(--text-secondary)]': !active,
        'bg-indigo-500 dark:bg-indigo-500 text-white ring-2 ring-indigo-300 dark:ring-indigo-400 font-semibold shadow-sm shadow-indigo-500/20': active,
      }}
    >
      #{tag}
    </span>
  )
}