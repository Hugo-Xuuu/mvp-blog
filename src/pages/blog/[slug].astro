---
import Layout from '../../layouts/Layout.astro';
import PostMeta from '../../components/PostMeta.astro';
import TagBadge from '../../components/TagBadge.astro';
import { getAllPosts } from '../../lib/content';
import { estimateReadingTime } from '../../lib/utils';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;

const { Content, headings } = await render(post);
const readingTime = estimateReadingTime(post.body || '');

const allPosts = await getAllPosts();
const currentIndex = allPosts.findIndex((p) => p.id === post.id);
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;

const slug = post.id.replace(/\.md$/, '');
const hasTOC = headings && headings.filter((h) => h.depth <= 3).length > 1;
---

<Layout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.date.toISOString()}
  tags={post.data.tags}
>
  <!-- 阅读进度条 -->
  <div id="reading-progress" class="reading-progress"></div>

  <div class="flex gap-8 relative">
    <!-- 文章主体 -->
    <article class="flex-1 min-w-0 max-w-3xl animate-fade-up">
      <header class="mb-10">
        <div class="flex flex-wrap gap-2 mb-4">
          {post.data.tags.map((tag) => (
            <TagBadge tag={tag} href={`/tags/${encodeURIComponent(tag)}`} />
          ))}
        </div>
        <h1 class="text-3xl sm:text-5xl font-semibold tracking-tight text-[var(--text-primary)] leading-[1.1] mb-4">
          {post.data.title}
        </h1>
        <PostMeta date={post.data.date} readingTime={readingTime} />
      </header>

      <div class="prose prose-neutral dark:prose-invert max-w-none
                  prose-headings:font-semibold prose-headings:tracking-tight
                  prose-a:text-indigo-600 dark:prose-a:text-indigo-400 prose-a:no-underline hover:prose-a:underline
                  prose-code:font-mono prose-pre:relative">
        <Content />
      </div>

      {post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-8 pt-8 border-t border-[var(--border-color)]">
          {post.data.tags.map((tag) => (
            <TagBadge tag={tag} href={`/tags/${encodeURIComponent(tag)}`} />
          ))}
        </div>
      )}

      <nav class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {prevPost ? (
          <a href={`/blog/${prevPost.id.replace(/\.md$/, '')}`}
             class="group rounded-2xl border border-[var(--border-color)] bg-[var(--bg-card)] p-5 transition-all hover:-translate-y-0.5 hover:shadow-lg">
            <span class="text-xs text-[var(--text-tertiary)] font-mono">← 上一篇</span>
            <p class="mt-1 font-medium text-[var(--text-primary)] group-hover:text-indigo-500 transition-colors">{prevPost.data.title}</p>
          </a>
        ) : <div />}
        {nextPost ? (
          <a href={`/blog/${nextPost.id.replace(/\.md$/, '')}`}
             class="group rounded-2xl border border-[var(--border-color)] bg-[var(--bg-card)] p-5 text-right transition-all hover:-translate-y-0.5 hover:shadow-lg sm:col-start-2">
            <span class="text-xs text-[var(--text-tertiary)] font-mono">下一篇 →</span>
            <p class="mt-1 font-medium text-[var(--text-primary)] group-hover:text-indigo-500 transition-colors">{nextPost.data.title}</p>
          </a>
        ) : <div />}
      </nav>
    </article>

    <!-- 桌面端 TOC -->
    <div class="hidden lg:block w-56 shrink-0">
      <div class="sticky top-32">
        {hasTOC && (
          <nav class="toc">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-[var(--text-tertiary)] mb-3">目录</h3>
            <ul class="space-y-1">
              {headings.filter((h) => h.depth <= 3).map((h) => (
                <li>
                  <a href={`#${h.slug}`} class="toc-link"
                     style={`padding-left: ${(h.depth - 2) * 0.75 + 0.75}rem;`}
                     data-heading-slug={h.slug}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </div>
    </div>

    <!-- 移动端 TOC 按钮（z-index 提高，防止被底部元素遮挡） -->
    <button id="mobile-toc-btn" class="mobile-toc-btn !z-[70]" aria-label="目录">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      目录
    </button>

    <!-- 移动端 TOC 底部抽屉（使用 transform，不依赖 Tailwind translate 属性） -->
    <div id="mobile-toc-drawer"
         class="fixed inset-x-0 bottom-0 z-[60] bg-[var(--bg-primary)] border-t border-[var(--border-color)] rounded-t-2xl shadow-2xl lg:hidden"
         style="max-height: 60vh; overflow-y: auto; transform: translateY(100%); pointer-events: none; transition: transform 0.3s ease-out;">
      <div class="flex items-center justify-between px-5 py-4 border-b border-[var(--border-color)]">
        <span class="font-semibold text-sm">目录</span>
        <button id="mobile-toc-close" class="p-1 rounded-lg hover:bg-[var(--tag-bg)] transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <div class="px-4 py-3" id="mobile-toc-list">
        {hasTOC && (
          <nav><ul class="space-y-1">
            {headings.filter((h) => h.depth <= 3).map((h) => (
              <li>
                <a href={`#${h.slug}`}
                   class="toc-link mobile-toc-link"
                   style={`padding-left: ${(h.depth - 2) * 0.75 + 0.75}rem;`}>{h.text}</a>
              </li>
            ))}
          </ul></nav>
        )}
      </div>
    </div>
  </div>
</Layout>

<script>
  // ── 阅读进度条 ──
  (() => {
    const bar = document.getElementById('reading-progress');
    if (!bar) return;
    const update = () => {
      const docH = document.documentElement.scrollHeight - window.innerHeight;
      bar.style.width = `${docH > 0 ? Math.min((window.scrollY / docH) * 100, 100) : 0}%`;
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  })();

  // ── TOC 滚动高亮 ──
  (() => {
    const links = document.querySelectorAll('.toc-link');
    if (!links.length) return;
    links.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const id = link.getAttribute('href')?.slice(1);
        if (!id) return;
        document.getElementById(id)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.pushState(null, '', `#${id}`);
      });
    });
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            links.forEach((l) => l.classList.toggle('active', l.getAttribute('data-heading-slug') === entry.target.id));
          }
        });
      },
      { rootMargin: '-80px 0px -70% 0px' }
    );
    document.querySelectorAll('article h2, article h3').forEach((h) => observer.observe(h));
  })();

  // ── 代码复制按钮 ──
  (() => {
    document.querySelectorAll('.prose pre').forEach((pre) => {
      if (pre.querySelector('.copy-button')) return;
      const code = pre.querySelector('code');
      if (!code) return;
      const btn = document.createElement('button');
      btn.className = 'copy-button';
      btn.innerHTML = '<svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg> 复制';
      pre.style.position = 'relative';
      pre.appendChild(btn);
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code.textContent || '');
          btn.innerHTML = '<svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> 已复制';
          btn.classList.add('copied');
          setTimeout(() => {
            btn.innerHTML = '<svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg> 复制';
            btn.classList.remove('copied');
          }, 2000);
        } catch { btn.textContent = '失败'; setTimeout(() => { btn.innerHTML = '复制'; }, 1500); }
      });
    });
  })();

  // ── 移动端 TOC ──
  (() => {
    const btn = document.getElementById('mobile-toc-btn');
    const drawer = document.getElementById('mobile-toc-drawer');
    const closeBtn = document.getElementById('mobile-toc-close');
    const list = document.getElementById('mobile-toc-list');
    if (!btn || !drawer) return;

    // ★ 将 drawer 和 btn 移到 body（根层叠上下文），彻底避免 <main> 子层叠上下文限制
    if (drawer.parentNode !== document.body) document.body.appendChild(drawer);
    if (btn.parentNode !== document.body) document.body.appendChild(btn);

    // ★ 直接设置高优先级 z-index，确保始终高于 BackToTop(z-50)
    btn.style.zIndex = '999';

    // 遮罩（根层叠上下文，z-index 低于 drawer）
    const overlay = document.createElement('div');
    overlay.className = 'fixed inset-0 bg-black/50 opacity-0 pointer-events-none transition-opacity duration-300 ease-out lg:hidden';
    overlay.style.zIndex = '55';
    document.body.appendChild(overlay);

    // drawer z-index
    drawer.style.zIndex = '60';

    // ── 辅助函数：判断 mobile-nav 是否打开 ──
    const isMobileNavOpen = () => document.getElementById('mobile-nav')?.classList.contains('open') ?? false;

    // ── 辅助函数：判断 TOC 是否已经打开 ──
    const isTocOpen = () => drawer.style.transform === 'translateY(0)' || drawer.style.transform === 'translateY(0px)';

    // ── 统一更新按钮可见性（合并所有条件）──
    const updateBtnDisplay = () => {
      if (isMobileNavOpen() || isTocOpen()) {
        btn.style.display = 'none';
      } else {
        btn.style.display = '';
      }
    };

    const openDrawer = () => {
      drawer.style.transform = 'translateY(0)';
      drawer.style.pointerEvents = 'auto';
      overlay.style.opacity = '1';
      overlay.style.pointerEvents = 'auto';
      document.body.style.overflow = 'hidden';
      updateBtnDisplay();
    };
    const closeDrawer = () => {
      drawer.style.transform = 'translateY(100%)';
      drawer.style.pointerEvents = 'none';
      overlay.style.opacity = '0';
      overlay.style.pointerEvents = 'none';
      document.body.style.overflow = '';
      updateBtnDisplay();
    };
    btn.addEventListener('click', openDrawer);
    closeBtn?.addEventListener('click', closeDrawer);
    overlay.addEventListener('click', closeDrawer);
    list?.addEventListener('click', (e) => {
      if (e.target.closest('.mobile-toc-link')) setTimeout(closeDrawer, 350);
    });

    // ★ 监听手机菜单状态变化：打开时关闭 TOC 并隐藏按钮；关闭时恢复按钮
    const mobileNavOverlay = document.getElementById('mobile-nav');
    if (mobileNavOverlay) {
      const mobObserver = new MutationObserver(() => {
        if (mobileNavOverlay.classList.contains('open')) {
          // 手机菜单打开时，如果 TOC 开着则关闭
          if (isTocOpen()) closeDrawer();
          btn.style.display = 'none';
        } else {
          // 手机菜单关闭时，如果 TOC 没开则恢复按钮
          if (!isTocOpen()) btn.style.display = '';
        }
      });
      mobObserver.observe(mobileNavOverlay, { attributes: true, attributeFilter: ['class'] });
    }
  })();
</script>