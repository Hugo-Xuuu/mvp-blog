---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getPaginatedPosts } from '../../lib/content';

const { posts, totalPages } = await getPaginatedPosts(1, 10);
const baseUrl = '/blog';
---

<Layout title="文章列表">
  <section class="animate-fade-up">
    <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-[var(--text-primary)] mb-2">全部文章</h1>
    <p class="text-[var(--text-secondary)] mb-8">
      第 1/{totalPages} 页
    </p>

    <div class="grid grid-cols-1 gap-4">
      {posts.map((post) => <PostCard post={post} />)}
    </div>

    <Pagination currentPage={1} totalPages={totalPages} baseUrl={baseUrl} />
  </section>
</Layout>