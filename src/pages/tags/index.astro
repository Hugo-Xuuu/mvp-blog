---
import Layout from '../../layouts/Layout.astro';
import TagBadge from '../../components/TagBadge.astro';
import { getAllTags, getPostCount } from '../../lib/content';

const tags = await getAllTags();
const postCount = await getPostCount();
---

<Layout title="标签">
  <section class="animate-fade-up max-w-3xl mx-auto">
    <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-[var(--text-primary)] mb-2">标签</h1>
    <p class="text-[var(--text-secondary)] mb-8">
      共 {tags.length} 个标签 · {postCount} 篇文章
    </p>

    <div class="flex flex-wrap gap-3">
      {tags.map((tag) => (
        <TagBadge tag={tag} href={`/tags/${encodeURIComponent(tag)}`} />
      ))}
    </div>

    {tags.length === 0 && (
      <p class="text-center text-[var(--text-tertiary)] py-12">暂无标签</p>
    )}
  </section>
</Layout>