---
import Layout from '../layouts/Layout.astro';
import ArchiveTimeline from '../components/ArchiveTimeline.astro';
import { getAllPosts } from '../lib/content';

const posts = await getAllPosts();
---

<Layout title="归档">
  <section class="animate-fade-up max-w-3xl mx-auto">
    <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-[var(--text-primary)] mb-2">归档</h1>
    <p class="text-[var(--text-secondary)] mb-10">
      共 {posts.length} 篇内容 · 按时间线排列
    </p>

    <ArchiveTimeline posts={posts} />
  </section>
</Layout>